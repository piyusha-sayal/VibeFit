{
  "expo": {
    "name": "MyLookFit",
    "slug": "vibefit",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/brand/icon.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#080808",
    "splash": {
      "image": "./assets/brand/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#080808"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.vibefit.app",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "MyLookFit needs access to your photos for style analysis.",
        "NSCameraUsageDescription": "MyLookFit uses your camera for real-time style analysis.",
        "NSFaceIDUsageDescription": "Used for secure authentication."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/brand/adaptive-icon.png",
        "monochromeImage": "./assets/brand/adaptive-monochrome.png",
        "backgroundColor": "#080808"
      },
      "package": "com.vibefit.app",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/brand/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "MyLookFit needs access to your photos for style analysis.",
          "cameraPermission": "MyLookFit uses your camera for real-time style analysis."
        }
      ],
      "expo-web-browser"
    ],
    "scheme": "vibefit",
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "8f7c7f5d-b5bf-48f0-974e-60d31b4ffeee"
      }
    },
    "owner": "piyusha_sayal"
  }
}
